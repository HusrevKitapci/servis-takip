# ============================================================================
# 1. BU DOSYANIN AMACI
# ============================================================================

# Bu dosya paylaşılabilir bir ayar şablonudur.
# Gerçek parolaları ve JWT anahtarlarını buraya yazma.
#
# Yeni kurulumda README.md içindeki komutla .env oluşturulur.
# Mevcut ve çalışan .env dosyasının üzerine yazılmaz.


# ============================================================================
# 2. WINDOWS ÜZERİNDEN POSTGRESQL BAĞLANTISI
# ============================================================================

# Python uygulaması Windows'ta çalışırken kullanılan adres.
# Docker içindeki API için compose.api.yaml bu iki değeri değiştirir.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

POSTGRES_DB=servis_takip
POSTGRES_USER=servis_user

# Yeni kurulumda rastgele üretilecek.
POSTGRES_PASSWORD=


# ============================================================================
# 3. TOKEN AYARLARI
# ============================================================================

# Yeni kurulumda rastgele üretilecek.
# Uygulama en az 64 karakter uzunluğunda bir anahtar ister.
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15